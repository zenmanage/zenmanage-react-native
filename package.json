{
  "name": "@zenmanage/react-native",
  "version": "0.1.0",
  "description": "React Native hooks and provider for Zenmanage feature flags",
  "keywords": [
    "react-native",
    "expo",
    "feature-flags",
    "feature-toggles",
    "ab-testing",
    "experiments",
    "zenmanage"
  ],
  "homepage": "https://github.com/zenmanage/zenmanage-react-native#readme",
  "bugs": {
    "url": "https://github.com/zenmanage/zenmanage-react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmanage/zenmanage-react-native.git"
  },
  "license": "MIT",
  "author": "Zenmanage",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage .vitest",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx,md}\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx,md}\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "@zenmanage/sdk": "^3.5.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@zenmanage/sdk": "^3.5.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "^0.74.5",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
